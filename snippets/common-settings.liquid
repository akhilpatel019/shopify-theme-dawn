{%- liquid
  assign s = section.settings
  assign wrapper = '#shopify-section-' | append: section.id
-%}
<style>
  {{ wrapper }} {
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    {%- case s.bg_type -%}
      {%- when 'color' -%}
        {%- case s.bg_color_source -%}
          {%- when 'global_primary' -%}
            background: var(--custom-primary-color);
          {%- when 'global_bg_1' -%}
            background: var(--custom-bg-color-1);
          {%- when 'global_bg_2' -%}
            background: var(--custom-bg-color-2);
          {%- when 'global_main_text' -%}
            background: var(--custom-main-text-color);
          {%- when 'global_black' -%}
            background: var(--custom-color-black);
          {%- when 'global_white' -%}
            background: var(--custom-color-white);
          {%- when 'custom' -%}
            background: {{ s.bg_color }};
        {%- endcase -%}
      {%- when 'gradient' -%}
        {%- if s.bg_gradient != blank -%}
          background: {{ s.bg_gradient }};
        {%- endif -%}
      {%- when 'image' -%}
        {%- if s.bg_image -%}
          background-image: url('{{ s.bg_image | image_url: width: 2000 }}');
          background-size: cover;
          background-repeat: no-repeat;
        {%- endif -%}
    {%- endcase -%}
  }
  @media (max-width: 768px) {
    {{ wrapper }} {
      padding-top: {{ s.padding_top_mobile }}px;
      padding-bottom: {{ s.padding_bottom_mobile }}px;
    }
  }
</style>
