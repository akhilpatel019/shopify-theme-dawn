{% render 'common-settings'
  , section: section %}
{{ 'hero.css' | asset_url | stylesheet_tag }}

<div class="main_hero_section">
    <div class="page-width hero-flex">

        <div class="hero-left">
          <div class="hero-text">
            <p class="star-icon">
              <img src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/five-star-icon.svg?v=1793774080" />
              <span>6,500+ five star reviews</span>
            </p>

            <h1 class="hero-title">{{section.settings.hero_section_title}}</h1>
           <div class="rte-custom hero-desc">
             {{section.settings.add_hero_section_description}}
           </div>
          </div>

          <div>
          

{% if section.settings.button_url != blank %}
  <a href="{{section.settings.button_url}}" class="hero-btn">{{section.settings.button_text}}</a>
{% endif %}
          </div>
        </div>

<div class="hero-right">
          <div class="hero-img-grid">

            {% if section.settings.set_image_1 != blank %}
  {{ section.settings.set_image_1 | image_url: width: 400 | image_tag: alt: 'Hero image 1' }}
{% endif %}

{% if section.settings.set_image_2 != blank %}
  {{ section.settings.set_image_2 | image_url: width: 400 | image_tag: alt: 'Hero image 2' }}
{% endif %}

{% if section.settings.set_image_3 != blank %}
  {{ section.settings.set_image_3 | image_url: width: 400 | image_tag: alt: 'Hero image 3' }}
{% endif %}

{% if section.settings.set_image_4 != blank %}
  {{ section.settings.set_image_4 | image_url: width: 400 | image_tag: alt: 'Hero image 4' }}
{% endif %}


          </div>
        </div>


    </div>
</div>


{% schema %}
  {
    "name": "Hero section",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "Hero section content"
      },
      {
        "type": "text",
        "label": "Add hero section title",
        "id": "hero_section_title",
        "default": "Paint Night, Delivered to You!"
      },
      {
        "type": "richtext",
        "label": "Add hero section description ",
        "id": "add_hero_section_description",
        "default": "<p>Fun art instructions + easy to use supplies</p><p>delivered to your doorstep.</p>"
      },
      {
        "type": "url",
        "label": "Set button url",
        "id": "button_url"
      }, {
        "type": "text",
        "label": "Set button text",
        "id": "button_text",
        "default": "Click Me"
      }, {
        "type": "header",
        "content": "Select for images for hero section"
      }, {
        "type": "image_picker",
        "label": "Set image 1",
        "id": "set_image_1"
      }, {
        "type": "image_picker",
        "label": "Set image 2",
        "id": "set_image_2"
      }, {
        "type": "image_picker",
        "label": "Set image 3",
        "id": "set_image_3"
      }, {
        "type": "image_picker",
        "label": "Set image 4",
        "id": "set_image_4"
      }, {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 8
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 8
      }, {
        "type": "header",
        "content": "Background"
      }, {
        "type": "select",
        "id": "bg_type",
        "label": "Background type",
        "options": [
          {
            "value": "none",
            "label": "None"
          }, {
            "value": "color",
            "label": "Color"
          }, {
            "value": "gradient",
            "label": "Gradient"
          }, {
            "value": "image",
            "label": "Image"
          }
        ],
        "default": "none"
      }, {
        "type": "select",
        "id": "bg_color_source",
        "label": "Color source",
        "options": [
          {
            "value": "global_primary",
            "label": "Primary Color"
          }, {
            "value": "global_bg_1",
            "label": "Background Color 1"
          }, {
            "value": "global_bg_2",
            "label": "Background Color 2"
          }, {
            "value": "global_main_text",
            "label": "Main Text Color"
          }, {
            "value": "global_black",
            "label": "Black"
          }, {
            "value": "global_white",
            "label": "White"
          }, {
            "value": "custom",
            "label": "Custom Color"
          }
        ],
        "default": "global_primary",
        "visible_if": "{{ section.settings.bg_type == 'color' }}"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Custom background color",
        "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
      }, {
        "type": "color_background",
        "id": "bg_gradient",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
      }, {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
      }
    ],
    "blocks": [],
    "presets": [
      {
        "name": "Hero section"
      }
    ]
  }
{% endschema %}