{% render 'common-settings', section: section %}
{{ 'faq.css' | asset_url | stylesheet_tag }}

<div class="faq-section">
  <div class="page-width">
    <h2 class="section-title">{{ section.settings.section_title }}</h2>

      <div class="faq-list">

    {% for block in section.blocks %}
      {% render 'faq_item', block: block %}
    {% endfor %}

</div>

  </div>
</div>




<script>
document.querySelectorAll('.faq-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = this.closest('.faq-item');
    var panel = item.querySelector('.faq-panel');
    var isOpen = item.classList.contains('active');

    // Close all open panels
    document.querySelectorAll('.faq-item.active').forEach(function(openItem) {
      openItem.classList.remove('active');
      openItem.querySelector('.faq-panel').style.maxHeight = null;
    });

    // Open clicked panel if it was closed
    if (!isOpen) {
      item.classList.add('active');
      panel.style.maxHeight = panel.scrollHeight + 'px';
    }
  });
});
</script>


{% schema %}
{
  "name": "Faq's",
  "settings": [
    {
      "type": "header",
      "content": "section settings"
    },
    {
      "type": "text",
      "default": "FAQ",
      "id": "section_title",
      "label": "Add section title"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ",
      "settings": [
        {
          "type": "header",
          "content": "Add Questions and answers"
        },
        {
          "type": "text",
          "id": "faq_qus",
          "default": "Question",
          "label": "Add question"
        },
        {
          "type": "richtext",
          "id": "faq_ans",
          "default": "<p>Answer</p>",
          "label": "Add Answer"
        }
      ]
    }
  ],
  "tag": "section",
  "presets": [
    {
      "name": "Faq's"
    }
  ]
}
{% endschema %}
