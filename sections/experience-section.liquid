{% render 'common-settings'
  , section: section %}
{{ 'experience.css' | asset_url | stylesheet_tag }}


<div class="experience_wrapper">
  <div class="page-width">
    <h2 class="section-title exp-title">{{ section.settings.section_title }}</h2>

    <div class="experience-steps">

      {% for block in section.blocks %}

        {% render 'exp-block'
          , block: block %}

      {% endfor %}


    </div>

        <div class="exp-shape-round">
        <img src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/rounde-shape-exp.svg?v=1794478757" alt="" />
      </div>



  </div>
</div>

{% schema %}
  {
    "name": "Experience section",
    "settings": [
      {
        "type": "header",
        "content": "Section settings"
      },
      {
        "type": "text",
        "default": "A Must Try Experience",
        "id": "section_title",
        "label": "Add section title"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom (desktop)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "padding_top_mobile",
        "label": "Padding top (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 8
      }, {
        "type": "range",
        "id": "padding_bottom_mobile",
        "label": "Padding bottom (mobile)",
        "min": 0,
        "max": 200,
        "step": 4,
        "unit": "px",
        "default": 8
      }, {
        "type": "header",
        "content": "Background"
      }, {
        "type": "select",
        "id": "bg_type",
        "label": "Background type",
        "options": [
          {
            "value": "none",
            "label": "None"
          }, {
            "value": "color",
            "label": "Color"
          }, {
            "value": "gradient",
            "label": "Gradient"
          }, {
            "value": "image",
            "label": "Image"
          }
        ],
        "default": "none"
      }, {
        "type": "select",
        "id": "bg_color_source",
        "label": "Color source",
        "options": [
          {
            "value": "global_primary",
            "label": "Primary Color"
          },
          {
            "value": "global_bg_1",
            "label": "Background Color 1"
          },
          {
            "value": "global_bg_2",
            "label": "Background Color 2"
          },
          {
            "value": "global_main_text",
            "label": "Main Text Color"
          }, {
            "value": "global_black",
            "label": "Black"
          }, {
            "value": "global_white",
            "label": "White"
          }, {
            "value": "custom",
            "label": "Custom Color"
          }
        ],
        "default": "global_primary",
        "visible_if": "{{ section.settings.bg_type == 'color' }}"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Custom background color",
        "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
      }, {
        "type": "color_background",
        "id": "bg_gradient",
        "label": "Background gradient",
        "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
      }, {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background image",
        "visible_if": "{{ section.settings.bg_type == 'image' }}"
      }
    ],
    "blocks": [
      {
        "type": "exp-block",
        "name": "Experience",
        "settings": [
          {
            "type": "header",
            "content": "Add experience content"
          }, {
            "type": "image_picker",
            "id": "exp-img",
            "label": "Add image"
          }, {
            "type": "text",
            "id": "exp-title",
            "label": "Add title",
            "default": "Experience title"
          }, {
            "type": "richtext",
            "id": "exp_desc",
            "default": "<p>Experience desorption</p>",
            "label": "Add desorption"
          }
        ]
      }
    ],
    "tag": "section",
    "presets": [
      {
        "name": "Experience section"
      }
    ]
  }
{% endschema %}