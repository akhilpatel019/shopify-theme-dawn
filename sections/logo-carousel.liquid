{% render 'common-settings', section: section %}
{{ 'carousel.css' | asset_url | stylesheet_tag }}


<div class="logo_carousel">
    <div class="page-width">
        <div class="logo-section">

                <div class="logo-text">
            <h4>{{ section.settings.carousel_title }}</h4>
          </div>

          <div class="logo-slider-wrapper">
  <div class="logo-slider swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% render 'logo_box', block: block %}
      {% endfor %}
    </div>
  </div>
</div>

        </div>
    </div>
</div>


<script>
let logoSwiper = null;
let resizeTimeout;

function initLogoSwiper() {
  if (typeof Swiper === 'undefined') return;

  const isTabletOrMobile = window.innerWidth < 1024;
  const sliderElement = document.querySelector('#shopify-section-{{ section.id }} .logo-slider');

  if (!sliderElement) return;

  if (isTabletOrMobile) {
    if (!logoSwiper) {
      logoSwiper = new Swiper(sliderElement, {
        slidesPerView: 2,
        spaceBetween: 15,
        loop: true,
        speed: 5000,
        autoplay: {
          delay: 0,
          disableOnInteraction: false,
          pauseOnMouseEnter: false,
        },
        allowTouchMove: true,
        watchOverflow: true,
        breakpoints: {
          480: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          768: {
            slidesPerView: 4,
            spaceBetween: 30,
          },
        },
      });
    } else {
      logoSwiper.update();
    }
  } else {
    if (logoSwiper) {
      logoSwiper.destroy(true, true);
      logoSwiper = null;
    }
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initLogoSwiper);
} else {
  initLogoSwiper();
}

window.addEventListener('resize', () => {
  clearTimeout(resizeTimeout);

  resizeTimeout = setTimeout(() => {
    initLogoSwiper();
  }, 200);
});

document.addEventListener('shopify:section:load', (event) => {
  if (event.target.id === 'shopify-section-{{ section.id }}') {
    logoSwiper = null;
    initLogoSwiper();
  }
});
</script>



{% schema %}
{
  "name": "Logo Carousel",
  "settings": [
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "text",
      "label": "Add carousel title",
      "id": "carousel_title",
      "default": "AS SEEN ON"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [
    {
        "type": "logo_box",
         "name": "Logo",
         "settings": [
            {
                "type": "header",
                "content": "Logo settings"
            },
            {
                "type": "image_picker",
                "id": "logo_img",
                "label": "Add logo"
            }
         ]
    }
  ],
  "tag": "section",
  "presets": [
    {
      "name": "Logo Carousel"
    }
  ]
}
{% endschema %}
