{% render 'common-settings', section: section %}
{{ 'nw-collection-list.css' | asset_url | stylesheet_tag }}

<div class="nw-collection-list">
  <div class="page-width">
    <h2 class="section-title">{{ section.settings.section_title }}</h2>

    <div class="all-category">
      {% for collection in section.settings.collections %}
        <div class="category-box">
          <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}">
          <div class="category-text-content">
            <h2>{{ collection.title }}</h2>
            <p>{{ collection.products_count }} paintings</p>
          </div>
        </div>
      {% endfor %}
    </div>

    

  </div>
</div>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "header",
      "content": "Collection list settings"
    },
    {
      "type": "text",
      "default": "Shop By Category",
      "id": "section_title",
      "label": "Add section title"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select collections",
      "limit": 4
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [],
  "tag": "section",
  "presets": [
    {
      "name": "Collection List"
    }
  ]
}
{% endschema %}
