{% render 'common-settings', section: section %}
{{ 'nw-collection.css' | asset_url | stylesheet_tag }}

<div class="nw-collection-wrapper">
  <div class="page-width">

    {% if section.settings.collection_title != blank %}
      <h2 class="section-title">
        {{ section.settings.collection_title }}
      </h2>
    {% endif %}

    <div class="product-section-grid">

     {% assign featured_collection = section.settings.choose_collection %}

{% if featured_collection != blank %}

  {% for product in featured_collection.products %}

    <div class="product">

      <a href="{{ product.url }}">
        {% if product.featured_image != blank %}
          {{
            product.featured_image
            | image_url: width: 600
            | image_tag: loading: 'lazy', alt: product.featured_image.alt
          }}
        {% endif %}
      </a>

      <div class="product-badge">
        {% assign product_badges = product.metafields.custom.product_badges.value %}

        {% for badge in product_badges %}
          {% case badge %}
            {% when 'JUNIOR PAINTING' %}
              <span class="junior-painting">{{ badge }}</span>

            {% when 'NEW' %}
              <span class="new">{{ badge }}</span>

            {% when 'DIPTYCH' %}
              <span class="diptych">{{ badge }}</span>
          {% endcase %}
        {% endfor %}
      </div>

      <div class="product-info">
        <div class="product-rate">
          <img src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/product-five-star.svg?v=1793790373" alt="" />
          <span>4 reviews</span>
        </div>

        <h3 class="product-title">
          <a href="{{ product.url }}">
            {{ product.title }}
          </a>
        </h3>

        <h6 class="product-prize">
          {% if product.price_varies %}
            {{ product.price_min | money }} to {{ product.price_max | money }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </h6>
      </div>

      {% form 'product', product %}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
        >

        <button
          type="submit"
          name="add"
          class="product-btn"
          {% unless product.available %}
            disabled
          {% endunless %}
        >
          <span>
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </span>

          {% if product.available %}
            <span>
             <img src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/plus-icon.svg?v=1793790684" alt="" />
            </span>
          {% endif %}
        </button>
      {% endform %}

    </div>

  {% endfor %}

{% else %}
  <p>Please select a collection</p>
{% endif %}

    </div>

  </div>
</div>


{% schema %}
{
  "name": "Painting collection",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Painting collection settings"
    },
    {
      "type": "text",
      "default": "Best Sellers",
      "id": "collection_title",
      "label": "Add section title"
    },
    {
      "type": "collection",
      "label": "Choose collection",
      "id": "choose_collection"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Painting collection"
    }
  ]
}
{% endschema %}