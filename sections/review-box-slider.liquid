{% render 'common-settings', section: section %}
{{ 'review-slider.css' | asset_url | stylesheet_tag }}


<div class="review-slider-section">
    <img
        src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/review-shape-top-left.svg?v=1793870454"
        class="review-shape review-shape-top-left"
        alt=""
        aria-hidden="true"
      />
      <img
        src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/review-shape-bottom-right.svg?v=1793870502"
        class="review-shape review-shape-bottom-right"
        alt=""
        aria-hidden="true"
      />


      <div class="page-width review-header-width">
        <div class="review-title-box">
          <h2 class="section-title review-title">
          {{section.settings.section_title}}
          </h2>
          <img
            src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/review-title-bottom-shape.png?v=1793870658"
            class="review-title-bottom-img"
            alt=""
          />
        </div>
        <img
          src="https://cdn.shopify.com/s/files/1/0842/3030/7949/files/rounde-shape-review.svg?v=1793870696"
          class="review-badge-img"
          alt="Easy to follow video tutorials"
        />
      </div>


      <div class="swiper reviewSwiper">

        <div class="swiper-wrapper">

          {% for block in section.blocks %}
             {% render 'review_slide', block: block %}
          {% endfor %}

        </div>

      </div>

      {% if section.blocks.size > 1 %}
      <div class="review-swiper-controls">
        <button class="review-swiper-prev" aria-label="Previous slide">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="#0C187E"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>

        <div class="swiper-pagination review-swiper-pagination"></div>

        <button class="review-swiper-next" aria-label="Next slide">
          <svg
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="#0C187E"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
      {% endif %}

      <div class="review-btn-box">
        <a class="primary-btn" href="#">see all reviews</a>
      </div>

</div>




<script>
(function() {
  let reviewSwiperInstance = null;

  function initReviewSlider() {
    const sectionElement = document.querySelector('#shopify-section-{{ section.id }}');
    if (!sectionElement) return;

    const swiperEl = sectionElement.querySelector('.reviewSwiper');
    if (!swiperEl || typeof Swiper === 'undefined') return;

    if (reviewSwiperInstance) {
      reviewSwiperInstance.destroy(true, true);
      reviewSwiperInstance = null;
    }

    const slidesCount = swiperEl.querySelectorAll('.swiper-slide').length;
    const canLoop = slidesCount > 2;

    reviewSwiperInstance = new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 28,
      centeredSlides: slidesCount > 1,
      loop: canLoop,
      watchOverflow: true,
      autoplay: canLoop ? {
        delay: 3500,
        disableOnInteraction: true,
        pauseOnMouseEnter: true,
      } : false,
      pagination: {
        el: sectionElement.querySelector('.review-swiper-pagination'),
        clickable: true,
      },
      navigation: {
        nextEl: sectionElement.querySelector('.review-swiper-next'),
        prevEl: sectionElement.querySelector('.review-swiper-prev'),
      },
      breakpoints: {
        0: {
          spaceBetween: 20,
        },
        768: {
          spaceBetween: 30,
        },
        1024: {
          spaceBetween: 40,
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReviewSlider);
  } else {
    initReviewSlider();
  }

  document.addEventListener('shopify:section:load', (e) => {
    if (e.target.id === 'shopify-section-{{ section.id }}') {
      initReviewSlider();
    }
  });
})();
</script>

{%  schema  %} 
{
   "name": "Review Slider",
   "settings": [
    {
        "type": "header",
        "content": "Section settings"
    },
    {
        "type": "text",
        "default": "Join Over 200,000+ Happy Customers",
        "id": "section_title",
        "label": "Add section title"
    },
     {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }


  
   ],
   "blocks": [
    {
        "type": "review_slide",
        "name": "Review Slide",
        "settings": [
            {
                "type": "header",
                "content": "Add Review"
            },
            {
                "type": "image_picker",
                "id": "review_img",
                "label": "Add feedback image"
            },
            {
                "type": "text",
                "default": "@username",
                "id": "review_name",
                "label": "Add username with @"
            },
            {
                "type": "text",
                "default": "Slide title",
                "id": "review_title",
                "label": "Add Title"
            },
            {
                "type": "richtext",
                "default": "<p>review....</p>",
                "id": "review_description",
                "label": "Write review"
            },
            {
                "type": "text",
                "default": "painting",
                "id": "review_painting_name",
                "label": "Add painting name"
            }
        ]
    }
   ],
   "class": "review-sections",
   "tag": "section",
   "presets": [
    {
        "name": "Review Slider"
    }
   ]
}
{% endschema %} 
