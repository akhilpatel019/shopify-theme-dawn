{% render 'common-settings', section: section %}
{{ 'how-it-work.css' | asset_url | stylesheet_tag }}



<div>
    <div class="page-width">
        <h2 class="section-title">{{section.settings.section_title}}</h2>

            <div class="how-inner">

                 {% for block in section.blocks %}
                      {% render 'steps-card', block: block %}
                 {% endfor %}

            </div>

    </div>
</div>


{%  schema  %} 
{
    "name": "How it Work",
    "settings": [
        {
            "type": "header",
            "content": "Section settings"
        },
        {
            "type": "text",
            "default": "How it works?",
            "id": "section_title",
            "label": "Add section title"
        },

        {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        },
        {
          "value": "image",
          "label": "Image"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "bg_color_source",
      "label": "Color source",
      "options": [
        {
          "value": "global_primary",
          "label": "Primary Color"
        },
        {
          "value": "global_bg_1",
          "label": "Background Color 1"
        },
        {
          "value": "global_bg_2",
          "label": "Background Color 2"
        },
        {
          "value": "global_main_text",
          "label": "Main Text Color"
        },
        {
          "value": "global_black",
          "label": "Black"
        },
        {
          "value": "global_white",
          "label": "White"
        },
        {
          "value": "custom",
          "label": "Custom Color"
        }
      ],
      "default": "global_primary",
      "visible_if": "{{ section.settings.bg_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Custom background color",
      "visible_if": "{{ section.settings.bg_type == 'color' and section.settings.bg_color_source == 'custom' }}"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.bg_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.bg_type == 'image' }}"
    }
        
    ],
    "blocks": [
        {
            "type": "steps-card",
            "name": "Step",
            "limit": 3,
            "settings": [
                {
                    "type": "richtext",
                    "default": "<h5>Choose & order your<br/> painting kits.</h5>",
                    "id": "step_title",
                    "label": "Add title"
                },
                {
                    "type": "number",
                    "default": 1,
                    "id": "step_num",
                    "label": "Add index number",
                    "max": 3,
                    "min": 0
                }
            ]
        }
    ],
    "tag": "section",
    "class": "how-it-work",
    "presets": [
    {
      "name": "How it Work"
    }
    ]
}
{% endschema %} 